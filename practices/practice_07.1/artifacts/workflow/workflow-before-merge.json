    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/nullifierx1/n8n-code-review-test/pulls/5/reviews",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    event: \"COMMENT\",\n    body: \"🤖 AI Inline Code Review\",\n    comments: [\n      {\n        path: $(\"Parse Diff Hunks\").first().json.path,\n        line: $(\"Parse Diff Hunks\").first().json.line,\n        side: $(\"Parse Diff Hunks\").first().json.side,\n        body: $json.output\n      }\n    ]\n  }\n}}",
        "options": {}
      },
