    {
      "parameters": {
        "jsCode": "\nconst diff = $input.first().json.data;\n\nif (typeof diff !== 'string') {\n  throw new Error('Expected diff text in data');\n}\n\nconst result = [];\n\nlet file = null;\nlet hunk = null;\nlet newLine = 0;\nlet oldLine = 0;\n\nfunction saveHunk() {\n  if (!hunk) return;\n\n  if (hunk.line === null) {\n    // Hunk contains no added lines.\n    // Anchor the comment to a removed line.\n    hunk.line = hunk.deletedLine;\n    hunk.side = 'LEFT';\n  }\n\n  if (hunk.line !== null) {\n    result.push({\n      json: {\n        path: file,\n        hunk_index: result.length + 1,\n        line: hunk.line,\n        side: hunk.side,\n        patch: hunk.lines.join('\\n'),\n      },\n    });\n  }\n}\n\nfor (const row of diff.split('\\n')) {\n  if (row.startsWith('diff --git ')) {\n    saveHunk();\n    hunk = null;\n    file = null;\n    continue;\n  }\n\n  if (row.startsWith('+++ b/')) {\n    file = row.slice(6);\n    continue;\n  }\n\n  if (row === '+++ /dev/null') {\n    file = null;\n    continue;\n  }\n\n  const match = row.match(\n    /^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/\n  );\n\n  if (match) {\n    saveHunk();\n\n    oldLine = Number(match[1]);\n    newLine = Number(match[2]);\n\n    hunk = {\n      lines: [row],\n      line: null,\n      deletedLine: null,\n      side: 'RIGHT',\n    };\n    continue;\n  }\n\n  if (!hunk) continue;\n\n  if (row.startsWith('+')) {\n    hunk.line = newLine;\n    newLine++;\n  } else if (row.startsWith('-')) {\n    hunk.deletedLine = oldLine;\n    oldLine++;\n  } else if (row.startsWith(' ')) {\n    oldLine++;\n    newLine++;\n  } else if (row.startsWith('\\\\ No newline')) {\n    // Metadata, not a source line.\n  }\n\n  hunk.lines.push(row);\n}\n\nsaveHunk();\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
