    {
      "id": "3b4e0dcf-8209-4f60-b1b0-26a6a2a7e3ec",
      "name": "Collect Inline Comments",
      "type": "n8n-nodes-base.code",
      "position": [
        1584,
        160
      ],
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const hunks = $('Parse Diff Hunks').all();\nconst reviews = $input.all();\nif (hunks.length !== reviews.length) {\n  throw new Error(`Hunk count ${hunks.length} != AI response count ${reviews.length}`);\n}\nconst comments = hunks.map((hunk, i) => {\n  const data = hunk.json;\n  const body = String(reviews[i].json.output ?? '').trim();\n  if (!body) throw new Error(`AI response is empty for hunk ${i + 1}`);\n  if (!data.path || !Number.isInteger(data.line) || !['LEFT','RIGHT'].includes(data.side)) {\n    throw new Error(`Invalid inline anchor for hunk ${i + 1}`);\n  }\n  return {path:data.path, line:data.line, side:data.side, body};\n});\nconst command = $('Parse PR Comment').first().json.command;\nreturn [{json: {event:'COMMENT', body:`🤖 AI Inline Code Review · ${command === '/make_ai_review' ? 'GPT-5 via VseLLM' : 'DeepSeek Flash'}\\n\\nПроверено блоков: ${comments.length}`, comments}}];"
      }
