    {
      "parameters": {
        "jsCode": "const diff = $input.first().json.data;\nif (typeof diff !== 'string') throw new Error('Expected diff text in Get PR Diff.data');\n\nconst result = [];\nlet file = null;\nlet hunk = null;\nlet oldLine = 0;\nlet newLine = 0;\n\nfunction saveHunk() {\n  if (!hunk) return;\n  const line = hunk.addedLine ?? hunk.deletedLine;\n  const side = hunk.addedLine !== null ? 'RIGHT' : 'LEFT';\n  if (!file || line === null) return;\n  result.push({json: {\n    path: file,\n    hunk_index: result.length + 1,\n    line, side,\n    patch: hunk.lines.join('\\n'),\n  }});\n}\nfor (const row of diff.split('\\n')) {\n  if (row.startsWith('diff --git ')) {\n    saveHunk();\n    hunk = null;\n    file = null;\n    continue;\n  }\n  if (row.startsWith('--- a/')) { if (!file) file = row.slice(6); continue; }\n  if (row.startsWith('+++ b/')) { file = row.slice(6); continue; }\n  const match = row.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n  if (match) {\n    saveHunk();\n    oldLine = Number(match[1]);\n    newLine = Number(match[2]);\n    hunk = {lines: [row], addedLine: null, deletedLine: null};\n    continue;\n  }\n  if (!hunk) continue;\n  hunk.lines.push(row);\n  if (row.startsWith('+')) { hunk.addedLine = newLine; newLine++; }\n  else if (row.startsWith('-')) { hunk.deletedLine = oldLine; oldLine++; }\n  else if (row.startsWith(' ')) {oldLine++; newLine++;}\n}\nsaveHunk();\nif (!result.length) throw new Error('No text diff hunks found: no inline review was posted or recorded');\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
