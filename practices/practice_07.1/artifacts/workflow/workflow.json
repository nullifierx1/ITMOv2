      "parameters": {
        "jsCode": "const body = /** @type {any} */ ($input.first().json.body);\n\nif (!body || body.action !== 'created' || !body.issue?.pull_request) {\n  return [];\n}\n\nconst command = String(body.comment?.body ?? '').trim();\n\nif (\n  command !== '/make_ai_review' &&\n  command !== '/make_other_ai_review'\n) {\n  return [];\n}\n\nconst repository = body.repository?.full_name;\nconst prNumber = Number(body.issue.number);\n\nif (\n  repository !== 'nullifierx1/n8n-code-review-test' ||\n  !Number.isInteger(prNumber) ||\n  prNumber <= 0\n) {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      command,\n      repository,\n      pr_number: prNumber,\n      review_key: `${repository}#${prNumber}`,\n      model: command === '/make_ai_review'\n        ? 'openai/gpt-5'\n        : 'deepseek-flash',\n    },\n  },\n];"
      },
