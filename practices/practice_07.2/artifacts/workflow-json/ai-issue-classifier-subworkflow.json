          "name": "VseLLM ChatGPT"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"type\": {\"type\": [\"string\", \"null\"], \"enum\": [\"bug\", \"task\", \"feature\", null]}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}}, \"required\": [\"type\", \"confidence\"], \"additionalProperties\": false}"
      },
      "id": "7aa61703-1616-4f51-a1d9-241d68cbb164",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        496,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json.output;\nif (!result || typeof result !== 'object') {\n  throw new Error('AI classifier did not return structured data');\n}\nconst { type, confidence } = result;\nif (![null, 'bug', 'task', 'feature'].includes(type) ||\n    typeof confidence !== 'number' || !Number.isFinite(confidence) ||\n    confidence < 0 || confidence > 1) {\n  throw new Error('Invalid type or confidence returned by classifier');\n}\nreturn [{ json: { type, confidence } }];"
      },
      "id": "ae0afe99-0470-4183-ab5d-1d8fa4c68baf",
