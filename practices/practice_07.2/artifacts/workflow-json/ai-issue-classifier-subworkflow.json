    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this GitHub Issue using its title and body.\n\nTitle: {{ $json.title }}\nBody: {{ $json.body }}\n\nCategories:\n- bug: observed defect, regression or unexpected behavior in existing software.\n- task: concrete maintenance, documentation, testing or engineering work without a new user-facing capability.\n- feature: request for a new user-facing capability or enhancement.\n\nReturn exactly two JSON fields: type and confidence. type must be bug, task, feature or null. confidence is a numeric estimate between 0 and 1.\nIf the report is vague, ambiguous, or insufficiently described, use type null and confidence below 0.8. Do not infer missing details or add commentary.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a careful GitHub Issue triage classifier. Follow the attached structured output schema. Do not invent issue details."
        }
      },
      "id": "9a15e494-2be9-4365-a3e5-0ef9e0412486",
      "name": "AI Issue Classifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
