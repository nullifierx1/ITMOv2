    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body ?? $input.first().json;\n\n// GitHub \"issues\" can emit actions other than \"opened\".\n// Pull requests also have issue-like data, so reject them explicitly.\nif (payload.action !== 'opened' || !payload.issue || payload.issue.pull_request) {\n  return [];\n}\n\nif (payload.repository?.full_name !== 'nullifierx1/n8n-code-review-test') {\n  return [];\n}\n\nreturn [{ json: payload }];"
      },
      "id": "9ead0edf-a97b-4cc9-b7e9-9fcc0e0fde9f",
      "name": "Filter Opened Issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const event = $input.first().json;\nconst number = Number(event.issue?.number);\n\nif (!Number.isInteger(number) || number <= 0) {\n  throw new Error('Missing or invalid GitHub issue number');\n}\n\nreturn [{\n  json: {\n    repository: event.repository.full_name,\n    owner: event.repository.owner.login,\n    repo: event.repository.name,\n    issue_number: number,\n    title: String(event.issue.title ?? ''),\n    body: String(event.issue.body ?? ''),\n    author: String(event.issue.user?.login ?? ''),\n    issue_url: String(event.issue.html_url ?? ''),\n    author_association: String(event.issue.author_association ?? ''),\n  },\n}];"
      },
      "id": "19520d9b-8e3e-441f-943f-4090287e1773",
      "name": "Prepare Issue Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst { type, confidence } = result;\nif (![null, 'bug', 'task', 'feature'].includes(type) ||\n    typeof confidence !== 'number' || !Number.isFinite(confidence) ||\n    confidence < 0 || confidence > 1) {\n  throw new Error('Invalid classification type or confidence');\n}\nconst original = $('Prepare Issue Data').first().json;\nreturn [{ json: { ...original, type, confidence, route: type === null || confidence < 0.8 ? 'needs-triage' : type } }];"
      },
